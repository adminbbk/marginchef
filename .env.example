# ── Database (Neon) ─────────────────────────────────────────────
# Pooled connection string (used by the app):
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.me-central-1.aws.neon.tech/marginchef?sslmode=require"
# Direct (non-pooled) connection string (used by `prisma migrate`):
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxxx.me-central-1.aws.neon.tech/marginchef?sslmode=require"
# Offline alternative: `npm run db:local` prints a local URL to use for DATABASE_URL.

# ── Auth.js ─────────────────────────────────────────────────────
# Generate with: npx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET=""
AUTH_TRUST_HOST=true

# Magic links via Resend. Leave empty in development: links are written to
# .dev-outbox/<email>.txt and the server log instead.
AUTH_RESEND_KEY=""
AUTH_EMAIL_FROM="MarginChef <login@yourdomain.com>"

# Google sign-in (optional; the button only shows when both are set).
# Redirect URI: http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
