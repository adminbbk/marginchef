// MarginChef schema. See PLAN.md section 4.
//
// Conventions:
// - Money is Int in fils (1 AED = 100 fils). Never Float.
// - Quantities are Decimal(12,4). Percentages are Decimal(7,4), e.g. 28.0000.
// - Every customer-data table has `outletId`. Child tables carry it too, and
//   reference their parents through composite (id, outletId) foreign keys, so
//   the database itself refuses a row that points at another outlet's data.
// - Optional composite relations use onDelete: NoAction (SetNull would null
//   the shared, required outletId column).

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── Auth.js ────────────────────────────────────────────────────────────────

model User {
  id            String       @id @default(cuid())
  name          String?
  email         String?      @unique
  emailVerified DateTime?
  image         String?
  accounts      Account[]
  sessions      Session[]
  memberships   Membership[]
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
}

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@id([provider, providerAccountId])
}

model Session {
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@id([identifier, token])
}

// ─── Organisation and outlets (not outlet-scoped) ───────────────────────────

model Organization {
  id               String       @id @default(cuid())
  name             String
  plan             Plan         @default(TRIAL)
  stripeCustomerId String?
  outlets          Outlet[]
  members          Membership[]
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
}

model Outlet {
  id                String       @id @default(cuid())
  orgId             String
  name              String
  slug              String       @unique // public direct-order page /o/[slug]
  emirate           String       @default("Dubai")
  vatRegistered     Boolean      @default(true)
  targetFoodCostPct Decimal      @default(30) @db.Decimal(7, 4)
  whatsappNumber    String?
  org               Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  suppliers        Supplier[]
  ingredients      Ingredient[]
  ingredientPrices IngredientPrice[]
  invoices         Invoice[]
  invoiceLines     InvoiceLine[]
  recipes          Recipe[]
  recipeLines      RecipeLine[]
  channels         Channel[]
  menuItems        MenuItem[]
  channelPrices    ChannelPrice[]
  orders           Order[]
  orderItems       OrderItem[]
  payoutImports    PayoutImport[]

  @@index([orgId])
}

model Membership {
  id        String       @id @default(cuid())
  userId    String
  orgId     String
  role      Role
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  org       Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  createdAt DateTime     @default(now())

  @@unique([userId, orgId])
  @@index([orgId])
}

// ─── Outlet-scoped tables ───────────────────────────────────────────────────

model Supplier {
  id        String   @id @default(cuid())
  outletId  String
  name      String
  trn       String? // UAE Tax Registration Number
  phone     String?
  outlet    Outlet   @relation(fields: [outletId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  invoices         Invoice[]
  ingredientPrices IngredientPrice[]

  @@unique([id, outletId])
  @@index([outletId])
}

model Ingredient {
  id                     String   @id @default(cuid())
  outletId               String
  name                   String
  baseUnit               Unit // g, ml, pc
  yieldPct               Decimal  @default(100) @db.Decimal(7, 4) // usable % after trimming
  currentCostPerBaseUnit Decimal  @default(0) @db.Decimal(18, 6) // fils per g/ml/pc, derived by lib/margin
  outlet                 Outlet   @relation(fields: [outletId], references: [id], onDelete: Cascade)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  prices       IngredientPrice[]
  recipeLines  RecipeLine[]
  invoiceLines InvoiceLine[]

  @@unique([id, outletId])
  @@index([outletId])
}

model IngredientPrice {
  id            String       @id @default(cuid())
  outletId      String
  ingredientId  String
  supplierId    String?
  invoiceLineId String?
  packQty       Decimal      @db.Decimal(12, 4) // e.g. 5
  packUnit      Unit // e.g. kg
  packPriceFils Int // excl. VAT
  effectiveAt   DateTime
  outlet        Outlet       @relation(fields: [outletId], references: [id], onDelete: Cascade)
  ingredient    Ingredient   @relation(fields: [ingredientId, outletId], references: [id, outletId], onDelete: Cascade)
  supplier      Supplier?    @relation(fields: [supplierId, outletId], references: [id, outletId], onDelete: NoAction)
  invoiceLine   InvoiceLine? @relation(fields: [invoiceLineId, outletId], references: [id, outletId], onDelete: NoAction)
  createdAt     DateTime     @default(now())

  @@index([outletId])
  @@index([ingredientId, effectiveAt])
}

model Invoice {
  id          String        @id @default(cuid())
  outletId    String
  supplierId  String?
  source      InvoiceSource // PHOTO, PDF, EINVOICE_XML
  fileUrl     String?
  invoiceNo   String?
  invoiceDate DateTime?
  totalFils   Int?
  vatFils     Int?
  status      InvoiceStatus @default(UPLOADED)
  rawJson     Json?
  outlet      Outlet        @relation(fields: [outletId], references: [id], onDelete: Cascade)
  supplier    Supplier?     @relation(fields: [supplierId, outletId], references: [id, outletId], onDelete: NoAction)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  lines InvoiceLine[]

  @@unique([id, outletId])
  @@index([outletId, status])
}

model InvoiceLine {
  id            String      @id @default(cuid())
  outletId      String
  invoiceId     String
  description   String
  qty           Decimal     @db.Decimal(12, 4)
  unit          String
  unitPriceFils Int
  vatRatePct    Decimal     @default(5) @db.Decimal(7, 4)
  ingredientId  String? // set when owner confirms the match
  confidence    Decimal?    @db.Decimal(5, 4)
  outlet        Outlet      @relation(fields: [outletId], references: [id], onDelete: Cascade)
  invoice       Invoice     @relation(fields: [invoiceId, outletId], references: [id, outletId], onDelete: Cascade)
  ingredient    Ingredient? @relation(fields: [ingredientId, outletId], references: [id, outletId], onDelete: NoAction)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  ingredientPrices IngredientPrice[]

  @@unique([id, outletId])
  @@index([outletId])
  @@index([invoiceId])
}

model Recipe {
  id          String   @id @default(cuid())
  outletId    String
  name        String
  category    String?
  isSubRecipe Boolean  @default(false) // sauces, doughs
  portions    Decimal  @default(1) @db.Decimal(12, 4)
  outlet      Outlet   @relation(fields: [outletId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  lines     RecipeLine[] @relation("RecipeLines")
  usedIn    RecipeLine[] @relation("SubRecipeUsage")
  menuItems MenuItem[]

  @@unique([id, outletId])
  @@index([outletId])
}

model RecipeLine {
  id           String      @id @default(cuid())
  outletId     String
  recipeId     String
  ingredientId String?
  subRecipeId  String?
  qty          Decimal     @db.Decimal(12, 4)
  unit         Unit
  outlet       Outlet      @relation(fields: [outletId], references: [id], onDelete: Cascade)
  recipe       Recipe      @relation("RecipeLines", fields: [recipeId, outletId], references: [id, outletId], onDelete: Cascade)
  ingredient   Ingredient? @relation(fields: [ingredientId, outletId], references: [id, outletId], onDelete: NoAction)
  subRecipe    Recipe?     @relation("SubRecipeUsage", fields: [subRecipeId, outletId], references: [id, outletId], onDelete: NoAction)

  @@index([outletId])
  @@index([recipeId])
  @@index([ingredientId])
  @@index([subRecipeId])
}

model Channel {
  id               String         @id @default(cuid())
  outletId         String
  type             ChannelType
  commissionPct    Decimal        @db.Decimal(7, 4) // e.g. 28
  commissionBase   CommissionBase @default(NET) // what commission is charged on; contracts differ
  fixedFeeFils     Int            @default(0) // per order
  paymentFeePct    Decimal        @default(0) @db.Decimal(7, 4)
  pricesIncludeVat Boolean        @default(true)
  outlet           Outlet         @relation(fields: [outletId], references: [id], onDelete: Cascade)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  prices        ChannelPrice[]
  orders        Order[]
  payoutImports PayoutImport[]

  @@unique([id, outletId])
  @@unique([outletId, type])
}

model MenuItem {
  id                String   @id @default(cuid())
  outletId          String
  recipeId          String
  name              String
  packagingCostFils Int      @default(0) // used on delivery/takeaway
  outlet            Outlet   @relation(fields: [outletId], references: [id], onDelete: Cascade)
  recipe            Recipe   @relation(fields: [recipeId, outletId], references: [id, outletId], onDelete: NoAction)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  prices     ChannelPrice[]
  orderItems OrderItem[]

  @@unique([id, outletId])
  @@index([outletId])
}

model ChannelPrice {
  id         String   @id @default(cuid())
  outletId   String
  menuItemId String
  channelId  String
  priceFils  Int
  outlet     Outlet   @relation(fields: [outletId], references: [id], onDelete: Cascade)
  menuItem   MenuItem @relation(fields: [menuItemId, outletId], references: [id, outletId], onDelete: Cascade)
  channel    Channel  @relation(fields: [channelId, outletId], references: [id, outletId], onDelete: Cascade)
  updatedAt  DateTime @updatedAt

  @@unique([menuItemId, channelId])
  @@index([outletId])
}

model Order {
  id                           String        @id @default(cuid())
  outletId                     String
  channelId                    String
  externalId                   String?
  placedAt                     DateTime
  grossFils                    Int // what customer paid, incl. VAT
  commissionFils               Int           @default(0)
  feesFils                     Int           @default(0)
  restaurantFundedDiscountFils Int           @default(0)
  payoutFils                   Int?
  importBatchId                String?
  outlet                       Outlet        @relation(fields: [outletId], references: [id], onDelete: Cascade)
  channel                      Channel       @relation(fields: [channelId, outletId], references: [id, outletId], onDelete: NoAction)
  importBatch                  PayoutImport? @relation(fields: [importBatchId, outletId], references: [id, outletId], onDelete: NoAction)
  createdAt                    DateTime      @default(now())

  items OrderItem[]

  @@unique([id, outletId])
  @@unique([outletId, channelId, externalId]) // re-importing a statement must not duplicate orders
  @@index([outletId, placedAt])
}

model OrderItem {
  id            String    @id @default(cuid())
  outletId      String
  orderId       String
  menuItemId    String?
  name          String
  qty           Int
  unitPriceFils Int
  outlet        Outlet    @relation(fields: [outletId], references: [id], onDelete: Cascade)
  order         Order     @relation(fields: [orderId, outletId], references: [id, outletId], onDelete: Cascade)
  menuItem      MenuItem? @relation(fields: [menuItemId, outletId], references: [id, outletId], onDelete: NoAction)

  @@index([outletId])
  @@index([orderId])
  @@index([menuItemId])
}

model PayoutImport {
  id          String   @id @default(cuid())
  outletId    String
  channelId   String
  fileUrl     String
  periodStart DateTime
  periodEnd   DateTime
  status      String
  outlet      Outlet   @relation(fields: [outletId], references: [id], onDelete: Cascade)
  channel     Channel  @relation(fields: [channelId, outletId], references: [id, outletId], onDelete: NoAction)
  createdAt   DateTime @default(now())

  orders Order[]

  @@unique([id, outletId])
  @@index([outletId])
}

// ─── Enums ──────────────────────────────────────────────────────────────────

enum Plan {
  TRIAL
  STARTER
  PRO
}

enum Role {
  OWNER
  MANAGER
  STAFF
}

enum Unit {
  g
  kg
  ml
  l
  pc
}

enum InvoiceSource {
  PHOTO
  PDF
  EINVOICE_XML
}

enum InvoiceStatus {
  UPLOADED
  PARSED
  CONFIRMED
  FAILED
}

enum ChannelType {
  DINE_IN
  TAKEAWAY
  TALABAT
  DELIVEROO
  CAREEM
  KEETA
  NOON
  DIRECT
}

enum CommissionBase {
  GROSS // VAT-inclusive price
  NET // ex-VAT price
}
